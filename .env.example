# Credenciales de https://my.telegram.org -> API development tools.
# Son las MISMAS que usa c90ToTelegram: puedes copiarlas de su .env.
# Si no existe este archivo, el script cae al .env de c90ToTelegram.
TG_API_ID=
TG_API_HASH=

# Nombre del supergrupo. Se crea solo en la primera ejecucion.
WWE_CHANNEL=WWE

# --- Opcionales ---------------------------------------------------------
# MODO NORMAL (vigilancia de novedades).
# Las novedades estan en las primeras paginas: subir esto no aporta nada
# y alarga cada pasada (cada pagina = 10 items + 1.5s de espera).
WWE_MAX_PAGES=4          # cuanto MIRA por pasada  (4 = 40 items)
WWE_MAX_SEND=12          # cuanto PUBLICA por pasada
WWE_FIRST_RUN_SEND=5     # publicaciones en el primer arranque
WWE_SEND_DELAY=3         # segundos entre publicaciones
WWE_INTERVAL_MINUTES=30  # solo en modo --loop
WWE_RETENTION_DAYS=45    # dias que recuerda lo publicado
WWE_LOOSE_IMAGES=1       # 1 = tambien las imagenes sueltas de la home
                         #     (hero, trending, carruseles; jpg/png/etc.)
WWE_ALBUM_MAX=10         # fotos del album de muestra de una galeria
                         # (tope de Telegram: 10)

# DOS EJECUCIONES INDEPENDIENTES (cada una con su lock y su progreso):
#   python wwe_telethon.py                      portada, novedades
#   python wwe_telethon.py --backfill --limit 50  portada, archivo historico
#   python wwe_telethon.py --photos --limit 10    galerias, desde /photos
# Ambas van por tandas, guardan el avance y se reanudan solas.
